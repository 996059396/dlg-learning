# ── Dependencies ──────────────────────────────────────────────
node_modules/

# ── Build output ──────────────────────────────────────────────
frontend/dist/

# ── Runtime data & secrets (SQLite DBs contain password hashes) ──
*.db
*.db-shm
*.db-wal

# ── Logs ──────────────────────────────────────────────────────
*.log
backend/server_restart.err.log

# ── Dev dumps & screenshots ───────────────────────────────────
**/*_dump*.txt
screenshots/
shiqun_*.txt

# ── OS / editor ───────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/

# 一次性临时脚本（crosscheck5 建议）
_tmp_*

# 桌面构建产物/内嵌运行时（electron-builder 输出, 勿入库）
desktop/release/
desktop/vendor/
